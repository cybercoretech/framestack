{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@site/*": ["./*"]
    },
    "types": ["@docusaurus/module-type-aliases", "@docusaurus/theme-classic"],
    "strict": true,
    "noEmit": true
  },
  "include": [
    "docusaurus.config.ts",
    "sidebars.ts",
    "src/**/*"
  ]
}
